# MySQL connection string for the /api/sessions and /api/login functions.
# In production set it with: vercel env add DATABASE_URL
DATABASE_URL=mysql://user:password@host:3306/claude_sessions

# Optional: single-owner dashboard login (see web/scripts/set-password.js).
# AUTH_SECRET=<random-32+-char-string>   # HMAC key that signs the auth cookie
# PUBLIC_REPOS=repo-one,repo-two         # repos visible to the public (fail-closed)
