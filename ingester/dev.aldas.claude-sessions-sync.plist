<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hourly full-sync launchd service. Runs `ingest.js --all` every hour as a
  safety net behind the real-time watcher, guaranteeing Turso reflects every
  session at least once an hour even if the watcher was down.
  Installed by ./install-hourly-sync.sh (which fills in the node + dir paths).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.aldas.claude-sessions-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DIR__/ingest.js</string>
    <string>--all</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>StandardOutPath</key>
  <string>__DIR__/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/sync.log</string>
</dict>
</plist>
