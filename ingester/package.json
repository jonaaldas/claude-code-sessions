{
  "name": "claude-sessions-ingester",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Collects Claude Code session metadata into Turso",
  "bin": {
    "claude-sessions-ingest": "./ingest.js"
  },
  "scripts": {
